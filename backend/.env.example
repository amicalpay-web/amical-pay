# Server Configuration
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# FazerCards API
FAZER_API_KEY=your_fazer_api_key_here
