# Server Configuration
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# FazerCards API (REQUIRED for production)
# Get your API key from FazerCards Dashboard: https://dashboard.fazercards.com
# NEVER commit this file with a real API key
# Always use Render Secrets for production
FAZER_API_KEY=

# Admin Token (for protected endpoints like /api/admin/*)
# Generate a secure random token: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
