# Server Configuration
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000,https://amicalpay.com,https://www.amicalpay.com

# FazerCards API (REQUIRED for production)
# Get your API key from FazerCards Dashboard: https://dashboard.fazercards.com
# NEVER commit this file with a real API key
# Always use Render Secrets for production
FAZER_API_KEY=
FAZER_API_BASE_URL=https://api.fzr.cards/api/v2

# Admin Token (for protected endpoints like /api/admin/*)
# Generate a secure random token: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# MonCash
MONCASH_MODE=sandbox
MONCASH_CLIENT_ID=
MONCASH_SECRET_KEY=
MONCASH_API_BASE_URL=https://sandbox.moncashbutton.digicelgroup.com/Api
MONCASH_GATEWAY_BASE_URL=https://sandbox.moncashbutton.digicelgroup.com/Moncash-middleware
MONCASH_RETURN_URL=https://api.amicalpay.com/api/webhook/moncash
MONCASH_ALERT_URL=https://amicalpay.com/payment-success
